# Supabase (client-side — safe to expose with VITE_ prefix)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional override. Dev uses /api/akool. Production uses
# ${VITE_SUPABASE_URL}/functions/v1/akool-proxy when this is unset.
# VITE_AKOOL_API_BASE=https://your-project-ref.supabase.co/functions/v1/akool-proxy
#
# Users paste their own Akool key in Settings. It is saved to their account.

# Supabase server-side (Vite dev proxy JWT verification only — never use VITE_ prefix)
# SUPABASE_URL must match VITE_SUPABASE_URL; SUPABASE_ANON_KEY must match VITE_SUPABASE_ANON_KEY
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
